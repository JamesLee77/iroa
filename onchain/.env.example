# IROA V1 · Base Sepolia deployment — variable NAMES only. Copy to onchain/.env (git-ignored)
# and fill the values locally. Never paste values into chat, commits, or transcripts.
# Runbook: docs/architecture/runbooks/v1-sepolia-rehearsal.md

# Chain access (Hardhat configVariable: env var or `npx hardhat keystore set <NAME>`)
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY=

# Deployment profile and manifest path
DEPLOYMENT_PROFILE=base-sepolia
DEPLOYMENT_MANIFEST=deployments/base-sepolia/v1.json

# Genesis and control addresses (two-person review before signing)
GENESIS_SAFE=
PAUSER_SAFE=
COMPLIANCE_SAFE=
SUSPENDER_SAFE=
ROOT_PROPOSER_SAFE=
CHALLENGER_SAFE=

# Vault beneficiaries and managers
TEAM_BENEFICIARY=
INVESTOR_BENEFICIARY=
FOUNDATION_BENEFICIARY=
TREASURY=
RELEASE_MANAGER=

# Vesting start (approved UTC epoch seconds, uint64)
VESTING_START_TIMESTAMP=
