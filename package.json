{
  "name": "iroa-ai-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "onchain",
    "control-api",
    "node-agent",
    "verifier",
    "sandbox",
    "operator",
    "admin"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:all": "npm run test:run && npm run test --workspaces --if-present",
    "typecheck": "astro check",
    "typecheck:all": "npm run typecheck && npm run typecheck --workspaces --if-present",
    "render:og": "node tools/website/render-og-image.mjs",
    "sync:whitepaper-assets": "node tools/website/sync-whitepaper-assets.mjs",
    "build:artifact": "npm run sync:whitepaper-assets && npm run render:og && astro build",
    "build": "npm run sync:whitepaper-assets && npm run render:og && npm run typecheck && astro build",
    "build:all": "npm run build:artifact && npm run build --workspaces --if-present",
    "preview": "astro preview",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:all": "playwright test && npm run test:e2e --workspace sandbox && npm run test:e2e --workspace operator && npm run test:e2e --workspace admin"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.2.9",
    "github-slugger": "^2.0.0",
    "image-size": "^2.0.2",
    "lucide-astro": "^0.556.0",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "29.1.1",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
