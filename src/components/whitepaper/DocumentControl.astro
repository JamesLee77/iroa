---
import { stat } from 'node:fs/promises';
import path from 'node:path';
import { Download, FileText } from 'lucide-astro';
import pdfUrl from '../../../docs/whitepaper/exports/IROA_WHITEPAPER_KO.pdf?url';
import { REPOSITORY_ROOT } from '../../lib/whitepaper/assets';
import type { WhitepaperPublication, WhitepaperStatus } from '../../lib/whitepaper/types';

interface Props {
  publication: WhitepaperPublication;
}

const { publication } = Astro.props;
const expectedPdfPath = 'docs/whitepaper/exports/IROA_WHITEPAPER_KO.pdf';
if (publication.metadata.pdfPath !== expectedPdfPath) {
  throw new Error(`whitepaper PDF path must be ${expectedPdfPath}; received ${publication.metadata.pdfPath}`);
}
const pdf = await stat(path.join(REPOSITORY_ROOT, publication.metadata.pdfPath));
if (!pdf.isFile() || pdf.size === 0) throw new Error('whitepaper PDF must be a non-empty file');
const pdfSize = `${(pdf.size / (1024 * 1024)).toFixed(1)} MB`;

const statusLabels: Record<WhitepaperStatus, string> = {
  draft: '초안',
  validation: '검증 중',
  reviewed: '검토됨',
  published: '발행됨',
};
---

<section class="whitepaper-document-control" aria-label="백서 문서 정보">
  <div class="whitepaper-document-control__heading">
    <FileText aria-hidden="true" size={24} strokeWidth={1.75} />
    <div>
      <p class="section-kicker latin">DOCUMENT CONTROL</p>
      <p>{publication.metadata.title}</p>
    </div>
  </div>
  <dl>
    <div><dt>버전</dt><dd class="latin tabular">v{publication.metadata.version}</dd></div>
    <div><dt>발행일</dt><dd><time datetime={publication.metadata.date} class="latin tabular">{publication.metadata.date}</time></dd></div>
    <div><dt>기준 언어</dt><dd>한국어 원문</dd></div>
    <div><dt>판본 상태</dt><dd>{statusLabels[publication.metadata.status]}</dd></div>
  </dl>
  <p class="whitepaper-document-control__authority">한국어판이 이 문서의 기준본입니다.</p>
  <a
    class="whitepaper-pdf-link latin"
    href={pdfUrl}
    download="IROA_WHITEPAPER_KO.pdf"
    aria-label={`PDF 다운로드 — PDF · ${pdfSize}`}
  >
    <span>PDF · {pdfSize}</span>
    <Download aria-hidden="true" size={18} strokeWidth={1.8} />
  </a>
</section>
