---
import { ChevronDown, Menu } from 'lucide-astro';
import wordmarkUrl from '../../docs/brand/masters/wordmark/iroa-wordmark-color.svg?url';
import ButtonLink from './primitives/ButtonLink.astro';

interface Props {
  locale?: 'ko' | 'en';
  currentPath?: string;
}

const { locale = 'ko', currentPath = '/' } = Astro.props;
const english = locale === 'en';
const root = english ? '/en/' : '/';
const whitepaper = english ? '/en/whitepaper' : '/whitepaper';
const navigationItems = english
  ? [
      { label: 'Protocol', href: '/en/#protocol' },
      { label: 'Network', href: '/en/#network' },
      { label: 'Economy', href: '/en/#economy' },
      { label: 'Whitepaper', href: '/en/whitepaper' },
      { label: 'Q&A', href: '/en/faq' },
      { label: 'Roadmap', href: '/en/#roadmap' },
    ]
  : [
      { label: '프로토콜', href: '/#protocol' },
      { label: '네트워크', href: '/#network' },
      { label: '이코노미', href: '/#economy' },
      { label: '백서', href: '/whitepaper' },
      { label: 'Q&A', href: '/faq' },
      { label: '로드맵', href: '/#roadmap' },
    ];
const translatable = ['/whitepaper', '/faq'];
const hasTranslation = (path: string) => translatable.some((base) => path === base || path.startsWith(`${base}/`));
const languageHref = english
  ? (hasTranslation(currentPath.replace(/^\/en/, '')) ? currentPath.replace(/^\/en/, '') : '/')
  : (hasTranslation(currentPath) ? `/en${currentPath}` : '/en/');
const copy = english
  ? { home: 'IROA.AI home', nav: 'Primary navigation', mobileNav: 'Mobile navigation', menu: 'Menu', cta: 'Read the whitepaper', language: '한국어' }
  : { home: 'IROA.AI 홈', nav: '주요 메뉴', mobileNav: '모바일 메뉴', menu: '메뉴', cta: '웹 백서 읽기', language: 'English' };
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__brand" href={root} aria-label={copy.home}>
      <img src={wordmarkUrl} alt="" width="600" height="180" />
    </a>

    <nav class="site-header__desktop-nav" aria-label={copy.nav}>
      <ul>
        {
          navigationItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__desktop-action">
      <a class="site-header__language" href={languageHref} hreflang={english ? 'ko' : 'en'}>{copy.language}</a>
      <ButtonLink href={whitepaper}>{copy.cta}</ButtonLink>
    </div>

    <details class="site-header__mobile-menu">
      <summary>
        <Menu aria-hidden="true" size={20} strokeWidth={2} />
        <span>{copy.menu}</span>
        <ChevronDown class="site-header__summary-chevron" aria-hidden="true" size={18} strokeWidth={2} />
      </summary>
      <div class="site-header__mobile-panel">
        <nav aria-label={copy.mobileNav}>
          <ul>
            {
              navigationItems.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))
            }
          </ul>
        </nav>
        <a class="site-header__language" href={languageHref} hreflang={english ? 'ko' : 'en'}>{copy.language}</a>
        <ButtonLink href={whitepaper}>{copy.cta}</ButtonLink>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 100;
    inset-block-start: 0;
    border-block-end: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .site-header__inner {
    display: flex;
    min-block-size: 5rem;
    align-items: center;
    gap: var(--space-4);
  }

  .site-header__brand {
    display: inline-flex;
    min-inline-size: var(--control-min);
    min-block-size: var(--control-min);
    align-items: center;
    padding-block: var(--space-2);
  }

  .site-header__brand img {
    inline-size: 7.5rem;
    block-size: auto;
  }

  .site-header__desktop-nav,
  .site-header__desktop-action {
    display: none;
  }

  .site-header__desktop-nav ul,
  .site-header__mobile-panel ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-header__mobile-menu {
    position: relative;
    margin-inline-start: auto;
  }

  .site-header__mobile-menu summary {
    display: inline-flex;
    min-inline-size: var(--control-min);
    min-block-size: var(--control-min);
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    font-weight: 700;
    list-style: none;
  }

  .site-header__mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__mobile-menu summary:hover {
    background: var(--color-surface-soft);
  }

  .site-header__mobile-menu :global(.site-header__summary-chevron) {
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .site-header__mobile-menu[open] :global(.site-header__summary-chevron) {
    transform: rotate(180deg);
  }

  .site-header__mobile-panel {
    position: absolute;
    inset-block-start: calc(100% + var(--space-2));
    inset-inline-end: 0;
    inline-size: min(20rem, calc(100vw - (2 * var(--gutter))));
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .site-header__mobile-panel nav {
    margin-block-end: var(--space-3);
  }

  .site-header__mobile-panel a:not([data-variant]) {
    display: flex;
    min-inline-size: var(--control-min);
    min-block-size: var(--control-min);
    align-items: center;
    padding-inline: var(--space-4);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .site-header__mobile-panel a:not([data-variant]):hover {
    background: var(--color-surface-soft);
  }

  .site-header__language {
    color: var(--color-text-muted);
    font-family: var(--font-latin);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }

  @media (min-width: 64rem) {
    .site-header__inner {
      gap: var(--space-5);
    }

    .site-header__brand img {
      inline-size: 8.5rem;
    }

    .site-header__desktop-nav {
      display: block;
      margin-inline-start: auto;
    }

    .site-header__desktop-nav ul {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    .site-header__desktop-nav a {
      display: inline-flex;
      min-inline-size: var(--control-min);
      min-block-size: var(--control-min);
      align-items: center;
      padding-inline: var(--space-3);
      border-radius: var(--radius-sm);
      text-decoration: none;
    }

    .site-header__desktop-nav a:hover {
      background: var(--color-surface-soft);
    }

    .site-header__desktop-action {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .site-header__mobile-menu {
      display: none;
    }
  }
</style>
