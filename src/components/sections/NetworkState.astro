---
import type { PublicStatus } from '../../lib/content/status';
import { NETWORK_SOURCE } from '../../lib/network/manifest';
import type { NodePageContent } from '../../types/node';
import StatusBadge from '../primitives/StatusBadge.astro';
import NetworkStateLive from './NetworkStateLive.astro';

interface Props {
  content: NodePageContent['networkState'];
  locale?: 'ko' | 'en';
  /** Index shown in the block heading, e.g. "06". */
  index: string;
}

const { content, locale = 'ko', index } = Astro.props;
const english = locale === 'en';
const source = NETWORK_SOURCE;

/**
 * Sepolia data is validation data and mainnet data is current; the page
 * never labels either as more than the manifest supports.
 */
const status: PublicStatus =
  source.kind === 'none' ? content.status : source.deployment.profile === 'base-mainnet' ? 'current' : 'validation';
---

<section class="node-block network-state" id="network-state" aria-labelledby="network-state-title">
  <div class="node-block__head">
    <span class="node-block__index tabular" aria-hidden="true">{index}</span>
    <h2 id="network-state-title">{content.title}</h2>
    <StatusBadge status={status} locale={locale} />
  </div>
  <p class="node-block__lead">{content.lead}</p>

  {source.kind === 'none' ? (
    <>
      <div class="network-state__source network-state__source--predeploy" role="note">
        <strong>{content.predeploy.title}</strong>
        <p>{content.predeploy.description}</p>
      </div>
      <ul class="network-state__metrics" aria-label={english ? 'Network metrics' : '네트워크 지표'}>
        {content.metrics.map((metric) => (
          <li data-metric={metric.id}>
            <span class="network-state__label">{metric.label}</span>
            <strong class="network-state__value tabular" data-value="pending">{content.placeholder}</strong>
            <span class="network-state__description">{metric.description}</span>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <NetworkStateLive content={content} deployment={source.deployment} locale={locale} />
  )}
</section>
