---
import { Image } from 'astro:assets';
import { ArrowRight } from 'lucide-astro';
import settlementVisual from '../../assets/home/iroa-settlement-boundary-v1.png';
import type { SettlementContent } from '../../types/home';
import SettlementRecord from '../patterns/SettlementRecord.astro';
import SectionIntro from '../primitives/SectionIntro.astro';

interface Props {
  content: SettlementContent;
  locale?: 'ko' | 'en';
}

const { content, locale = 'ko' } = Astro.props;
const english = locale === 'en';
---

<section id="settlement" class="home-section settlement-overview container" aria-labelledby="settlement-overview-title">
  <SectionIntro eyebrow="SETTLEMENT BOUNDARY" title={content.title} lead={content.description} id="settlement-overview-title" />
  <figure class="settlement-overview__visual">
    <Image
      src={settlementVisual}
      alt={english ? 'IROA settlement boundary separating everyday consumer payment, outcome verification, and institutional settlement' : '일상적인 소비자 결제와 결과 검증, 기관 간 정산을 서로 다른 계층으로 분리한 IROA 정산 경계'}
      widths={[640, 960, 1280]}
      sizes="(max-width: 1239px) calc(100vw - 2rem), 1240px"
      format="webp"
      quality={88}
      loading="lazy"
    />
    <figcaption><span>Consumer Payment</span><span>Verified Proof Gate</span><span>Base · Native USDC</span></figcaption>
  </figure>
  <div class="settlement-overview__grid">
    <div class="settlement-overview__flow">
      <p class="settlement-overview__consumer">{content.consumerPayment}</p>
      <ol>
        {
          content.steps.map((step, index) => (
            <li>
              <span class="tabular">0{index + 1}</span>
              <div><strong>{step.title}</strong><p>{step.description}</p></div>
              {index < content.steps.length - 1 && <ArrowRight aria-hidden="true" size={18} />}
            </li>
          ))
        }
      </ol>
    </div>
    <div class="settlement-overview__record">
      <SettlementRecord network={content.network} asset={content.asset} status={content.status} locale={locale} />
      <ul>{content.boundaries.map((boundary) => <li>{boundary}</li>)}</ul>
    </div>
  </div>
</section>
