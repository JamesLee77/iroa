---
import type { PublicStatus } from '../../lib/content/status';
import StatusBadge from '../primitives/StatusBadge.astro';

interface Props {
  purpose: string;
  permission: string;
  dataClass: 'D0' | 'D1' | 'D2' | 'D3' | 'D4';
  duration: string;
  status: PublicStatus;
  locale?: 'ko' | 'en';
}

const { purpose, permission, dataClass, duration, status, locale = 'ko' } = Astro.props;
const english = locale === 'en';
---

<section class="protocol-pattern task-capsule" aria-label={english ? 'Task Capsule details' : 'Task Capsule 상세'}>
  <dl class="protocol-definition-list">
    <div>
      <dt>{english ? 'Purpose' : '목적'}</dt>
      <dd>{purpose}</dd>
    </div>
    <div>
      <dt>{english ? 'Permission' : '권한'}</dt>
      <dd>{permission}</dd>
    </div>
    <div>
      <dt>{english ? 'Data class' : '데이터 등급'}</dt>
      <dd class="latin tabular">{dataClass}</dd>
    </div>
    <div>
      <dt>{english ? 'Duration' : '유효 시간'}</dt>
      <dd>{duration}</dd>
    </div>
    <div>
      <dt>{english ? 'Public status' : '공개 상태'}</dt>
      <dd><StatusBadge status={status} locale={locale} /></dd>
    </div>
  </dl>
</section>
