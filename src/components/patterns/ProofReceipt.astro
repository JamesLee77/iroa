---
interface Props {
  result: string;
  proofId: string;
  policyVersion: string;
  disputeState: string;
  locale?: 'ko' | 'en';
}

const { result, proofId, policyVersion, disputeState, locale = 'ko' } = Astro.props;
const english = locale === 'en';
---

<section class="protocol-pattern proof-receipt" aria-label={english ? 'Proof Receipt details' : 'Proof Receipt 상세'}>
  <dl class="protocol-definition-list">
    <div>
      <dt>{english ? 'Outcome' : '결과'}</dt>
      <dd>{result}</dd>
    </div>
    <div>
      <dt>{english ? 'Proof ID' : '증빙 ID'}</dt>
      <dd>{proofId}</dd>
    </div>
    <div>
      <dt>{english ? 'Policy baseline' : '정책 기준'}</dt>
      <dd>{policyVersion}</dd>
    </div>
    <div>
      <dt>{english ? 'Dispute state' : '분쟁 상태'}</dt>
      <dd>{disputeState}</dd>
    </div>
  </dl>
</section>
