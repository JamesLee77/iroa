---
import { getStatusLabel, type PublicStatus } from '../../lib/content/status';

interface Props {
  status: PublicStatus;
  label?: string;
  locale?: 'ko' | 'en';
}

const { status, locale = 'ko', label = getStatusLabel(status, locale) } = Astro.props;
---

<span class="status-badge" data-status={status}>
  <span class="status-badge__mark" aria-hidden="true"></span>
  <span>{label}</span>
</span>

<style>
  .status-badge {
    display: inline-flex;
    min-block-size: var(--control-min);
    align-items: center;
    gap: var(--space-2);
    /* Dark surfaces set --status-badge-color so the label and the
       currentColor mark stay readable against them. */
    color: var(--status-badge-color, var(--color-text));
    font-weight: 700;
  }

  .status-badge__mark {
    inline-size: var(--space-3);
    block-size: var(--space-3);
    flex: 0 0 auto;
    border: 2px solid currentColor;
    border-radius: 50%;
  }

  .status-badge[data-status='current'] .status-badge__mark {
    border-color: var(--color-verified);
    background: var(--color-verified);
  }

  .status-badge[data-status='next'] .status-badge__mark {
    border-color: var(--color-action);
    box-shadow: inset 0 0 0 2px var(--color-surface);
    background: var(--color-action);
  }

  .status-badge[data-status='planned'] .status-badge__mark {
    border-radius: 0.15rem;
  }

  .status-badge[data-status='validation'] .status-badge__mark {
    border-color: var(--color-verified);
    border-radius: 0.1rem;
    transform: rotate(45deg);
  }

  .status-badge[data-status='research'] .status-badge__mark {
    border-style: dotted;
  }
</style>
