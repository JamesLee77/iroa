---
import { ArrowLeft, BookOpen } from 'lucide-astro';
import ChapterIndex from '../components/whitepaper/ChapterIndex.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadWhitepaper } from '../lib/whitepaper/load';

const publication = await loadWhitepaper();
---

<SiteLayout
  title="페이지를 찾을 수 없습니다. | IROA.AI"
  description="요청한 IROA.AI 페이지를 찾을 수 없습니다."
  canonicalPath="/404"
  robots="noindex,nofollow"
>
  <section class="not-found container" aria-labelledby="not-found-title">
    <p class="section-kicker latin">404 · ROUTE RECOVERY</p>
    <h1 id="not-found-title">페이지를 찾을 수 없습니다.</h1>
    <p>주소가 바뀌었거나 아직 공개되지 않은 경로입니다. 홈 또는 정규화된 웹 백서 목차에서 다시 시작할 수 있습니다.</p>
    <div class="not-found__actions">
      <a href="/"><ArrowLeft aria-hidden="true" size={18} />홈으로</a>
      <a href="/whitepaper"><BookOpen aria-hidden="true" size={18} />웹 백서 목차</a>
    </div>
    <section class="not-found__whitepaper" aria-labelledby="not-found-whitepaper-title">
      <div>
        <p class="section-kicker latin">WHITEPAPER RECOVERY</p>
        <h2 id="not-found-whitepaper-title">웹 백서의 22개 장에서 이어 읽기</h2>
        <p>요청한 장을 찾을 수 없어도 정규화된 한국어 기준본의 전체 목차에서 바로 복구할 수 있습니다.</p>
      </div>
      <ChapterIndex chapters={publication.chapters} />
    </section>
  </section>
</SiteLayout>
