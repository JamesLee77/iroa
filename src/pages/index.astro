---
import EconomyStatus from '../components/sections/EconomyStatus.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import NetworkProof from '../components/sections/NetworkProof.astro';
import ParticipationContact from '../components/sections/ParticipationContact.astro';
import ProtocolPlanes from '../components/sections/ProtocolPlanes.astro';
import RoadmapPreview from '../components/sections/RoadmapPreview.astro';
import SettlementOverview from '../components/sections/SettlementOverview.astro';
import WhitepaperEntry from '../components/sections/WhitepaperEntry.astro';
import { homeKo } from '../content/home.ko';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="IROA.AI | 검증 가능한 실행 네트워크"
  description="IROA.AI는 노인과 장애인의 일상 요청을 사용자 승인, 검증된 NODE 실행, 최소 증빙으로 끝까지 잇는 실행 네트워크입니다. 프로토콜 구조, NODE 네트워크, 정산 경계와 백서를 공개합니다."
  canonicalPath="/"
  alternatePath="/en/"
>
  <div class="page--homepage">
    <HomeHero content={homeKo.hero} />
    <ProtocolPlanes content={homeKo.protocol} />
    <NetworkProof content={homeKo.network} />
    <SettlementOverview content={homeKo.settlement} />
    <EconomyStatus content={homeKo.economy} />
    <WhitepaperEntry content={homeKo.whitepaper} />
    <RoadmapPreview content={homeKo.roadmap} />
    <ParticipationContact content={homeKo.contact} />
  </div>
</SiteLayout>
